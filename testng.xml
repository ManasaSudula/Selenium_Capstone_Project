<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="SauceDemo Capstone Suite">

    <listeners>
        <!-- Handles Extent report + screenshot on failure -->
        <listener class-name="com.capstone.listeners.TestListener"/>
    </listeners>

    <!-- Group 1: quick checks of the most important flows -->
    <test name="Smoke Tests">
        <groups>
            <run>
                <include name="smoke"/>
            </run>
        </groups>
        <packages>
            <package name="com.capstone.tests"/>
        </packages>
    </test>

    <!-- Group 2: detailed positive + negative checks -->
    <test name="Regression Tests">
        <groups>
            <run>
                <include name="regression"/>
            </run>
        </groups>
        <packages>
            <package name="com.capstone.tests"/>
        </packages>
    </test>

</suite>
